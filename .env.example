# ─────────────────────────────────────────────────────────────────────────────
#  Parallax configuration  —  cp .env.example .env  and fill in PRIVATE_KEY
# ─────────────────────────────────────────────────────────────────────────────

# One testnet-only wallet used on all three chains (0x-prefixed). NEVER a mainnet key.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# RPC endpoints (public defaults work; swap in Alchemy/QuickNode if they rate-limit you)
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
REACTIVE_RPC=https://lasna-rpc.rnk.dev/

# Chain IDs
UNICHAIN_CHAIN_ID=1301
BASE_CHAIN_ID=84532
REACTIVE_CHAIN_ID=5318007

# Reactive callback proxies (dev.reactive.network/origins-and-destinations)
UNI_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
BASE_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585

# lREACT sent with the reactive deploy. Keep 0 and top up afterwards with a plain transfer
# (Lasna gas is ~100 gwei; the deploy itself costs ~0.22 lREACT).
REACTIVE_FUND=0ether

# Strategy parameters (18-decimal wei for token amounts)
# 5 pUSD minimum expected profit per arb
MIN_PROFIT_WEI=5000000000000000000
# 100,000 pUSD max per arb
MAX_TRADE_WEI=100000000000000000000000
# 1% floor on each leg
SLIPPAGE_BPS=100
# seconds a leg stays valid (timestamp deadline)
LEG_TTL=60
# seconds before a stuck arb stops blocking new ones
LOCK_TIMEOUT=120

# Executors (one per destination chain)
# 0.0002 ETH per executor pays for ~100 callbacks on these L2 testnets
EXECUTOR_GAS_FUND=200000000000000
# seconds between executions (timestamp based)
EXECUTOR_COOLDOWN=2
# 50 pWETH inventory per executor
INVENTORY_BASE=50000000000000000000
# 150,000 pUSD inventory per executor
INVENTORY_QUOTE=150000000000000000000000

# Extra flags for Lasna transactions, e.g. "--legacy" if your RPC rejects EIP-1559 txs
REACTIVE_TX_FLAGS=
